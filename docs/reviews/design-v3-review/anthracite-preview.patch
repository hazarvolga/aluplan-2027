+.preview-ribbon__inner{display:flex;gap:var(--space-inline-md);justify-content:space-between;align-items:center}
+.preview-shell{
+  min-height:100vh;
+  background:var(--surface-page)
+}
+.preview-section{padding-block:var(--space-stack-2xl)}
+.preview-section--subtle{background:var(--surface-subtle);border-block:var(--border-width-default) solid var(--border-default)}
